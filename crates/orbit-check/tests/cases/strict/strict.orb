//! orbit-check: strict
// Strict mode: typed public signatures, `bool` conditions, no untyped Lua modules.

use untyped; //~ T0504
use typed;

pub fn add(a: int, b) -> int { a + b } //~ T0501
pub fn twice(n: int) { n * 2 } //~ T0502
pub fn log(msg: string) { print(msg); }
fn private(a, b) { a + b }

pub struct Counter { n: int }
impl Counter {
    pub fn bump(self, by) { self.n += by; } //~ T0501
    fn helper(self, x) { x }
}

fn conditions(n: int, maybe: string?, flag: bool, value) {
    if n { print(n); } //~ T0503
    if maybe { print(maybe); } //~ T0503
    if maybe != nil { print(maybe); }
    if flag { print(flag); }
    if value { print(value); }
    while n > 0 { break; }
}

let t: int = typed::scale(2);
let s: string = 3; // orbit-check: ignore[T0201]
let u: string = 3; // orbit-check: ignore
