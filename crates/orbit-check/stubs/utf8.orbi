// The `utf8` library.

/// The UTF-8 encoding of these code points.
pub fn char(...codes: int) -> string;
/// The code points of the characters starting between bytes `i` and `j`.
pub fn codepoint(s: string, i: int?, j: int?, lax: bool?) -> ...int;
/// An iterator over the characters of `s`: `for (pos, code) in utf8::codes(s)`.
pub fn codes(s: string, lax: bool?) -> (fn(string, int) -> (int?, int), string, int);
/// The number of characters between bytes `i` and `j`, or `nil` and the first bad byte.
pub fn len(s: string, i: int?, j: int?, lax: bool?) -> (int?, int?);
/// Where the `n`th character from byte `i` starts and ends.
pub fn offset(s: string, n: int, i: int?) -> (int?, int?);

/// A pattern matching one UTF-8 character.
pub const charpattern: string;
