// The `coroutine` library.

/// Closes a suspended or dead coroutine: `true`, or `false` and its error.
pub fn close(co: thread) -> (bool, any);
/// A new coroutine running `f`.
pub fn create(f: function) -> thread;
/// Whether `co` (default the running coroutine) can yield.
pub fn isyieldable(co: thread?) -> bool;
/// Starts or continues `co`: `true` and what it yields or returns, or `false` and the error.
pub fn resume(co: thread, ...args: any);
/// The running coroutine, and whether it is the main one.
pub fn running() -> (thread, bool);
/// `"running"`, `"suspended"`, `"normal"` or `"dead"`.
pub fn status(co: thread) -> string;
/// A function that resumes a new coroutine running `f`, raising its errors.
pub fn wrap(f: function) -> function;
/// Suspends the running coroutine; `resume` returns `values`, and this returns what the next
/// `resume` passes.
pub fn r#yield(...values: any);
