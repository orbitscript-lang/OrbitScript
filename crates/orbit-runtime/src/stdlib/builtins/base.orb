// The base library's `ipairs` and `pairs`, written in OrbitScript (ADR-11).
//
// Built-in modules are compiled when orbit-runtime is built and loaded with
// the intrinsics as their only globals, so scripts can't reach or replace
// what they use. The debug interface shows their functions as C functions.
// A built-in avoids tail calls, which would drop its frame.
//
// Code that differs by Lua version (ADR-14) sits in `//#if lua-5.4` blocks,
// which the build resolves before compiling (`orbit_lua_version::preprocess`),
// so the bytecode never tests the version. A block holds whole items, so the
// file still parses as it is, for orbit-fmt and the language server.

use intrinsics::{argerror, metafield};

// The iterator `ipairs` returns: one function, so every call returns the
// same one, as the reference does.
fn ipairs_next(t, i) {
    let i = i + 1;
    let v = t[i];
    if v == nil {
        return nil;
    }
    (i, v)
}

pub fn ipairs(...args) {
    if args.n == 0 {
        argerror(1, "value expected");
    }
    (ipairs_next, args[1], 0)
}

//#if lua-5.4
// Lua 5.4: three values.
pub fn pairs(...args) {
    if args.n == 0 {
        argerror(1, "value expected");
    }
    let t = args[1];
    let h = metafield(t, "__pairs");
    if h != nil {
        let (f, s, c) = h(t);
        return (f, s, c);
    }
    (next, t, nil)
}
//#else
pub fn pairs(...args) {
    if args.n == 0 {
        argerror(1, "value expected");
    }
    let t = args[1];
    let h = metafield(t, "__pairs");
    if h != nil {
        // Exactly four of its results: the fourth is the loop's
        // to-be-closed value.
        let (f, s, c, tbc) = h(t);
        return (f, s, c, tbc);
    }
    (next, t, nil, nil)
}
//#endif
