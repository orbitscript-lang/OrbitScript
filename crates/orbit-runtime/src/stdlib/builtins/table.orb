// `table.sort`, written in OrbitScript (ADR-11). See base.orb for how
// built-in modules are compiled and loaded. `table.insert` and
// `table.remove` stay native until calls to Lua functions with varargs cost
// less: written here they ran about twice as long.
//
// Indexing and `#` go through the language's own operations, so `__index`,
// `__newindex` and `__len` apply as they do for the reference's table
// library. As in the reference, nothing may yield across them.

extern argerror, typeerror, raise, checktab, lenint, newarray, sortprim;

// The largest array `sort` accepts (a C `int`).
const MAX_SORT = 2147483647;

// A stable bottom-up merge sort over a copy of the elements, so each element
// is read and written once whatever metamethods the table has.
pub fn sort(t, ...rest) {
    checktab(t);
    let n = lenint(#t);
    if n <= 1 {
        return;
    }
    if n >= MAX_SORT {
        argerror(1, "array too big");
    }
    let lt = rest[1];
    if lt != nil && type(lt) != "function" {
        typeerror(2, "function", lt);
    }
    let mut src = newarray(n);
    let mut dst = newarray(n);
    for i in 1..=n {
        src[i] = t[i];
    }
    if lt == nil && sortprim(src, n) {
        for i in 1..=n {
            t[i] = src[i];
        }
        return;
    }
    let mut width = 1;
    while width < n {
        let mut lo = 1;
        while lo <= n {
            let mid = if lo + width <= n { lo + width } else { n + 1 };
            let hi = if lo + 2 * width <= n { lo + 2 * width } else { n + 1 };
            let mut i = lo;
            let mut j = mid;
            let mut k = lo;
            while k < hi {
                // Take the right element only if it is strictly smaller,
                // which keeps the sort stable.
                let mut right = i >= mid;
                if i < mid && j < hi {
                    if lt == nil {
                        right = src[j] < src[i];
                    } else if lt(src[j], src[i]) {
                        right = true;
                    }
                }
                if right {
                    dst[k] = src[j];
                    j += 1;
                } else {
                    dst[k] = src[i];
                    i += 1;
                }
                k += 1;
            }
            lo = hi;
        }
        let swap = src;
        src = dst;
        dst = swap;
        width *= 2;
    }
    // A comparator or `__lt` must be a strict order: no neighbour may come
    // out smaller than the one before it.
    for i in 2..=n {
        let bad = if lt == nil { src[i] < src[i - 1] } else { lt(src[i], src[i - 1]) };
        if bad {
            raise("invalid order function for sorting");
        }
    }
    for i in 1..=n {
        t[i] = src[i];
    }
}
