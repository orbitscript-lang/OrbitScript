#!/bin/sh
# rustc wrapper (set as `build.rustc-wrapper` in .cargo/config.toml): optimized
# builds use the committed PGO profile pgo/<target>.profdata, so a plain
# `cargo build --release` gives the profile-guided binary. Cargo can't attach
# the flag itself: profile rustflags are unstable, and repo-wide rustflags
# reach dependency crates, which rustc compiles from their own directories,
# where a relative profile path doesn't resolve. Here the path is absolute.
#
# Left alone: unoptimized compiles (dev builds, build scripts), compiles that
# already pass -Cprofile-generate or -Cprofile-use (`cargo testkit pgo`), and
# targets with no committed profile. See tests/README.md.
#
# `cargo testkit pgo` sets ORBIT_PGO_PROFILE to use another profile and
# ORBIT_PGO_FLAGS (space-separated) to add rustc flags to the same compiles.
# Flags in RUSTFLAGS would also reach build scripts and the crates they
# depend on, which aren't optimized and so have no profile.
rustc="$1"
shift

optimized=no
target=
prev=
for a in "$@"; do
    case "$a" in
        opt-level=3) [ "$prev" = "-C" ] && optimized=yes ;;
        -Copt-level=3) optimized=yes ;;
        *profile-generate* | *profile-use*) exec "$rustc" "$@" ;;
        --target=*) target="${a#--target=}" ;;
    esac
    [ "$prev" = "--target" ] && target="$a"
    prev="$a"
done

if [ "$optimized" = yes ]; then
    if [ -z "$target" ]; then
        target="$("$rustc" -vV | sed -n 's/^host: //p')"
    fi
    profile="${ORBIT_PGO_PROFILE:-$(cd "$(dirname "$0")/.." && pwd)/pgo/$target.profdata}"
    if [ -f "$profile" ]; then
        # With a profile, LLVM's loop vectorizer treats a loop whose measured
        # trip count is under 16 as tiny and vectorizes it with masked lanes
        # instead of a scalar remainder. Without masked stores (x86-64 before
        # AVX-512) each lane becomes a compare and a branch: clearing a few
        # registers after a native returns grew to about 280 instructions and
        # made coroutines 12% slower than the plain release build. A minimum
        # of 1 keeps the usual vector loop with a scalar remainder.
        # shellcheck disable=SC2086 # ORBIT_PGO_FLAGS is a list of flags
        exec "$rustc" "$@" "-Cprofile-use=$profile" "-Cllvm-args=-vectorizer-min-trip-count=1" ${ORBIT_PGO_FLAGS:-}
    fi
fi
exec "$rustc" "$@"
