#!/bin/sh
# rustc wrapper (set as `build.rustc-wrapper` in .cargo/config.toml): optimized
# builds use the committed PGO profile pgo/<target>.profdata, so a plain
# `cargo build --release` gives the profile-guided binary. Cargo can't attach
# the flag itself: profile rustflags are unstable, and repo-wide rustflags
# reach dependency crates, which rustc compiles from their own directories,
# where a relative profile path doesn't resolve. Here the path is absolute.
#
# Left alone: unoptimized compiles (dev builds, build scripts), compiles that
# already pass -Cprofile-generate or -Cprofile-use (`cargo testkit pgo`), and
# targets with no committed profile. See tests/README.md.
rustc="$1"
shift

optimized=no
target=
prev=
for a in "$@"; do
    case "$a" in
        opt-level=3) [ "$prev" = "-C" ] && optimized=yes ;;
        -Copt-level=3) optimized=yes ;;
        *profile-generate* | *profile-use*) exec "$rustc" "$@" ;;
        --target=*) target="${a#--target=}" ;;
    esac
    [ "$prev" = "--target" ] && target="$a"
    prev="$a"
done

if [ "$optimized" = yes ]; then
    if [ -z "$target" ]; then
        target="$("$rustc" -vV | sed -n 's/^host: //p')"
    fi
    profile="$(cd "$(dirname "$0")/.." && pwd)/pgo/$target.profdata"
    if [ -f "$profile" ]; then
        exec "$rustc" "$@" "-Cprofile-use=$profile" "-Cllvm-args=-vectorizer-min-trip-count=1"
    fi
fi
exec "$rustc" "$@"
